rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 128;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /placementTests/{testId} {
      allow read, write: if true;
    }

    match /vocab_tests/{testId} {
      allow read, write: if true;
    }

    match /vocab_reviews/{testId} {
      allow read, write: if true;
    }

    match /vocab_test_submissions/{subId} {
      allow read, write: if true;
    }

    match /classes/{classId} {
      allow read, write: if true;
    }

    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    match /test_results/{resultId} {
      allow read, write: if true;
    }

    match /class_spreadsheets/{docId} {
      allow read, write: if true;
    }

    match /deleted_records/{docId} {
      allow read, write: if true;
    }

    match /attendance/{docId} {
      allow read, write: if true;
    }

    match /leads/{docId} {
      allow read, write: if true;
    }

    match /transactions/{docId} {
      allow read, write: if true;
    }

    match /exams/{docId} {
      allow read, write: if true;
    }

    match /courses/{docId} {
      allow read, write: if true;
    }

    match /trialStudents/{docId} {
      allow read, write: if true;
    }

    match /contactNotes/{docId} {
      allow read, write: if true;
    }

    match /milestoneEvaluations/{docId} {
      allow read, write: if true;
    }

    match /kpis/{docId} {
      allow read, write: if true;
    }

    match /inventory/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
